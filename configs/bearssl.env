#!/bin/bash

PROJ_NAME=BearSSL
VERSION=0.6
SRC_DIR=${PROJ_NAME,,}
URL_GIT=https://www.bearssl.org/git/BearSSL
#URL_AR=https://bearssl.org/bearssl-0.6.tar.gz
#COMMIT=79c060ee  # Breaking Bad paper
COMMIT=3c04036  # latest commit 2024-06-12
URL_COMMIT=https://bearssl.org/gitweb/?p=BearSSL;a=commit;h=3c040368f6791553610e362401db1efff4b4c5b8

pull_source() {
  if [ -n "$URL_AR" ]; then
    FILE=$(basename $URL_AR)
    [ -f "$FILE" ] || wget $URL_AR -O $FILE
    mkdir -p $SRC_DIR
    bsdtar xf $FILE -C $SRC_DIR --strip-components=1
    return
  fi
  git clone $URL_GIT $SRC_DIR
  git config --global --add safe.directory $PWD/$SRC_DIR
  pushd $SRC_DIR; git checkout $COMMIT; popd
}

# PWD is root of project repo for funcs below

pre_build() {
  mkfile="conf/Unix.mk"
  # remove lines starting with "CC =", "CFLAGS =" from conf/Unix.mk
  # so it use our own CFLAGS
  sed -i '/^CC =/d' $mkfile
  sed -i '/^CFLAGS =/d' $mkfile
  # sed -i '/^LD =/d' $mkfile
  clean_build
}

build_target() {
  CFLAGS="-W -Wall -fPIC $CFLAGS"
  make CONF=Unix -j${JOBS:-$(nproc)} --output-sync
}

clean_build() {
  # make clean
  # HACK: some flags like --align-all-nofallthru-block=1024 may produce large file, just remove build/
  rm -rf build/*
}