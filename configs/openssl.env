#!/bin/bash

PROJ_NAME=OpenSSL
VERSION=3.4.1
SRC_DIR=${PROJ_NAME,,}
URL_GIT=https://github.com/openssl/openssl.git
#URL_AR=https://github.com/openssl/openssl/releases/download/openssl-3.4.1/openssl-3.4.1.tar.gz
COMMIT=2e1b046  # latest commit 2025-06-25

pull_source() {
  if [ -n "$URL_AR" ]; then
    FILE=$(basename $URL_AR)
    [ -f "$FILE" ] || wget $URL_AR -O $FILE
    mkdir -p $SRC_DIR
    bsdtar xf $FILE -C $SRC_DIR --strip-components=1
    return
  fi
  git clone $URL_GIT $SRC_DIR
  git config --global --add safe.directory $PWD/$SRC_DIR
  pushd $SRC_DIR; git checkout $COMMIT; popd
}

# PWD is root of project repo for funcs below

pre_build() {
  clean_build
}

build_target() {
  # TODO: fine-grained platform option shown in ./Configure LIST ?
  # see https://wiki.openssl.org/index.php/Compilation_and_Installation
  if [[ "$ARCH" == *32* || "$ARCH" == "ARM" ]]; then
    ./Configure linux-generic32 no-asm
  else
    ./Configure linux-generic64 no-asm
  fi
  make -j${JOBS:-$(nproc)} --output-sync
}

clean_build() {
  make clean
  make distclean
}
