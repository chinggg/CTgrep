#!/bin/bash

PROJ_NAME=pqclean
VERSION=
SRC_DIR=${PROJ_NAME,,}
URL_GIT=https://github.com/PQClean/PQClean
URL_AR=
COMMIT=2cc6471  # April 2025

pull_source() {
  git clone $URL_GIT $SRC_DIR
  git config --global --add safe.directory $PWD/$SRC_DIR
  pushd $SRC_DIR; git checkout $COMMIT; popd
}

# PWD is root of project repo for funcs below

pre_build() {
  clean_build
  find ./crypto_* -name Makefile | grep clean | while read -r makefile; do
    sed -i 's/^CFLAGS[[:space:]]*=/CFLAGS+=/g' "$makefile"
    sed -i 's/-O[23][[:space:]]//g' "$makefile"
  done
}

build_target() {
  find ./crypto_* -name Makefile | grep clean | grep -v mceliece | while read -r makefile; do
    make_dir=$(dirname "$makefile")
    make -C $make_dir -j${JOBS:-$(nproc)} --output-sync
  done
}

clean_build() {
  find ./crypto_* -name Makefile | grep clean | while read -r makefile; do
    make_dir=$(dirname "$makefile")
    make -C $make_dir clean
  done
}