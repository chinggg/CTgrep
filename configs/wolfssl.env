#!/bin/bash

PROJ_NAME=WolfSSL
VERSION=5.7.6
SRC_DIR=${PROJ_NAME,,}
URL_GIT=https://github.com/wolfSSL/wolfssl.git
#URL_AR=https://github.com/wolfSSL/wolfssl/archive/refs/tags/v5.7.6-stable.tar.gz
COMMIT=f119086  # latest commit 2025-06-25

pull_source() {
  if [ -n "$URL_AR" ]; then
    FILE=$(basename $URL_AR)
    [ -f "$FILE" ] || wget $URL_AR -O $FILE
    mkdir -p $SRC_DIR
    bsdtar xf $FILE -C $SRC_DIR --strip-components=1
    return
  fi
  git clone $URL_GIT $SRC_DIR
  git config --global --add safe.directory $PWD/$SRC_DIR
  pushd $SRC_DIR; git checkout $COMMIT; popd
}

# PWD is root of project repo for funcs below

pre_build() {
  clean_build
  libtoolize
  ./autogen.sh
}

build_target() {
  # oneliner to add "--host=$host" if $1 is not empty
  local host_opt=${1:+"--host=$1"}
  ./configure --disable-asm --enable-jobserver=no --enable-crypttests=no --enable-benchmark=no $host_opt
  make -j${JOBS:-$(nproc)} --output-sync
}

clean_build() {
  make clean
}
