#!/bin/bash

PROJ_NAME=mbedTLS
VERSION=3.6.2
SRC_DIR=${PROJ_NAME,,}
URL_GIT=https://github.com/Mbed-TLS/mbedtls.git
#URL_AR=https://github.com/Mbed-TLS/mbedtls/releases/download/mbedtls-3.6.2/mbedtls-3.6.2.tar.bz2
COMMIT=f68f45c  # latest commit 2025-06-25

pull_source() {
  if [ -n "$URL_AR" ]; then
    FILE=$(basename $URL_AR)
    [ -f "$FILE" ] || wget $URL_AR -O $FILE
    mkdir -p $SRC_DIR
    bsdtar xf $FILE -C $SRC_DIR --strip-components=1
    return
  fi
  git clone $URL_GIT $SRC_DIR
  git config --global --add safe.directory $PWD/$SRC_DIR
  pushd $SRC_DIR; git checkout $COMMIT; popd
}

# PWD is root of project repo for funcs below

pre_build() {
  clean_build
}

build_target() {
  [[ -f ./autogen.sh ]] && ./autogen.sh
  [[ -f ./configure ]] && ./configure --enable-jobserver=no
  git submodule update --init --recursive
  make no_test -j${JOBS:-$(nproc)} --output-sync
}

clean_build() {
  make clean
}