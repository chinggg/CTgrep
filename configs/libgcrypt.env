#!/bin/bash

PROJ_NAME=libgcrypt
VERSION=1.11.0
SRC_DIR=${PROJ_NAME,,}
URL_GIT=https://github.com/gpg/libgcrypt.git
#URL_AR=https://www.gnupg.org/ftp/gcrypt/libgcrypt/libgcrypt-1.11.0.tar.bz2
COMMIT=cbefff5  # latest commit 2025-06-25

pull_source() {
  if [ -n "$URL_AR" ]; then
    FILE=$(basename $URL_AR)
    [ -f "$FILE" ] || wget $URL_AR -O $FILE
    mkdir -p $SRC_DIR
    bsdtar xf $FILE -C $SRC_DIR --strip-components=1
    return
  fi
  git clone $URL_GIT $SRC_DIR
  git config --global --add safe.directory $PWD/$SRC_DIR
  pushd $SRC_DIR; git checkout $COMMIT; popd
}

# PWD is root of project repo for funcs below

pre_build() {
  clean_build
}

build_target() {
  # oneliner to add "--host=$host" if $1 is not empty
  local host_opt=${1:+"--host=$1"}
  # NOTE: must pass correct $HOST to cross-compile
  # see https://www.gnu.org/software/autoconf/manual/autoconf-2.71/html_node/Specifying-Target-Triplets.html
  # Unlike tarball, Git Repo has autogen.sh, run if it exists
  [[ -f ./autogen.sh ]] && ./autogen.sh
  PATH=$HOME/.local/bin:$PATH ./configure --disable-asm --disable-doc --with-libgpg-error-prefix=$HOME/.local $host_opt
  make -j${JOBS:-$(nproc)} --output-sync
  # make -C build -j1
  # ninja -C build -j1
}

clean_build() {
  make clean
  make distclean
  # rm -rf build
}
