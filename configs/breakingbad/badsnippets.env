#!/bin/bash

# Get script directory for relative paths
SCRIPT_DIR=$( cd -- "$( dirname -- "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )

PROJ_NAME=badsnippets
SRC_DIR=$PROJ_NAME

# List of Godbolt links with filenames
declare -A LINKS=(
    # Schneider et al. (Breaking Bad), 8 cases
    ["bearssl-modpow_opt-x8664"]="https://godbolt.org/z/nx1crrxv3"
    ["bearssl-modpow_opt-x86i386"]="https://godbolt.org/z/bnE1PrfKG"
    ["bearssl-br_i31_muladd_small-x86i386"]="https://godbolt.org/z/qM9KT31vz"
    ["bearssl-check_scalar-riscv64"]="https://godbolt.org/z/zvh6Pjzar"
    ["botan-hex_decode-riscv64"]="https://godbolt.org/z/hhs1KWfz7"
    ["botan-key_schedule-riscv64"]="https://godbolt.org/z/xGh6Kjzfh"
    ["hacl-cmovznz4-riscv64"]="https://godbolt.org/z/z71Wv5b7j"
    ['hacl-point_mul-x8664']="https://godbolt.org/z/6s9daKhxr"
    
    # Daniel et al. (Binsec/Rel), 5 cases
    ["binsec-ct_select_u32_v1-x8664"]="https://godbolt.org/z/jjK3EjP48"
    ["binsec-ct_select_u32_v2-x8664"]="https://godbolt.org/z/j4dnGb1sP"
    ["binsec-ct_select_u32_v3-x8664"]="https://godbolt.org/z/G3Mhq7Th5"
    ["binsec-ct_select_u32_v4-x8664"]="https://godbolt.org/z/o4b96Wfhz"
    ["binsec-sort2_multiplex-x8664"]="https://godbolt.org/z/Y7M9n63bM"
    
    # Lai et al. and Zhang and Barthe, 6 cases
    ["godbolt-vect_set_random_fixed_weight-x8664"]="https://godbolt.org/z/fdMWPq5d5"
    ["godbolt-crypto_uint32_signed_negative_mask-x8664"]="https://godbolt.org/z/YnxMTh657"
    ["godbolt-base_mul-x8664"]="https://godbolt.org/z/MPjq5odz1"
    ["wolfssl-sp_clamp_ct-x8664"]="https://godbolt.org/z/EvsaW56j9"
    ["wolfssl-Base64_Char2Val-x8664"]="https://godbolt.org/z/W53n1vKh3"
    ["godbolt-constant_time_msb_w-x8632"]="https://godbolt.org/z/7Gs53hTG6"
)


# Populate $SRC_DIR with the snippet sources. The artifact ships them under
# groundtruth/snippets/ (fetched from the Compiler Explorer links above), so
# no network access is needed; set SNIPPETS_FETCH=1 to re-download instead.
pull_source() {
  local vendored="$SCRIPT_DIR/../../groundtruth/snippets"
  mkdir -p $SRC_DIR && pushd $SRC_DIR || exit 1
  if [[ -z "${SNIPPETS_FETCH:-}" && -d "$vendored" ]]; then
    cp "$vendored"/*.c "$vendored"/*.cpp .
    echo "Copied $(ls *.c *.cpp | wc -l) snippet sources from $vendored"
  else
    for name in "${!LINKS[@]}"; do
        local link="${LINKS[$name]}"
        local id=$(basename "$link")  # Extract shortlink ID from URL
        # https://github.com/compiler-explorer/compiler-explorer/blob/main/docs/API.md
        local codeurl="https://godbolt.org/z/${id}/code/1"
        # Botan snippets are C++
        [[ $name == *botan-* ]] && local filename="${name}.cpp" || local filename="${name}.c"
        echo "Downloading source for $name from $codeurl"
        wget -q -O "$filename" "$codeurl"
        [[ -s "$filename" ]] || { echo "Failed to retrieve source for $name"; rm -f "$filename"; }
    done
  fi
  # NOTE: just use `-target <triple>` or get compiler option from godbolt
  cp $SCRIPT_DIR/Makefile .
  popd
}

# PWD is root of project repo for funcs below

pre_build() {
  :
}

build_target() {
  make all -j1 -k -i
}

clean_build() {
  make clean
}
