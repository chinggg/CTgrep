#!/bin/bash

PROJ_NAME=libsodium
VERSION=1.0.20
SRC_DIR=${PROJ_NAME,,}
URL_GIT=https://github.com/jedisct1/libsodium.git
#URL_AR=https://download.libsodium.org/libsodium/releases/libsodium-1.0.20-stable.tar.gz
COMMIT=fd8c876  # latest commit 2025-06-06

pull_source() {
  if [ -n "$URL_AR" ]; then
    FILE=$(basename $URL_AR)
    [ -f "$FILE" ] || wget $URL_AR -O $FILE
    mkdir -p $SRC_DIR
    bsdtar xf $FILE -C $SRC_DIR --strip-components=1
    return
  fi
  git clone $URL_GIT $SRC_DIR
  git config --global --add safe.directory $PWD/$SRC_DIR
  pushd $SRC_DIR; git checkout $COMMIT; popd
}

# PWD is root of project repo for funcs below

pre_build() {
  clean_build
}

build_target() {
  # oneliner to add "--host=$host" if $1 is not empty
  local host_opt=${1:+"--host=$1"}
  [[ -f ./autogen.sh ]] && ./autogen.sh -s
  ./configure --disable-asm $host_opt
  make -j${JOBS:-$(nproc)} --output-sync
  # make -C build -j1
  # ninja -C build -j1
}

clean_build() {
  make clean
  # rm -rf build
}
